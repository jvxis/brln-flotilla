# Build configuration for the BR⚡LN Community web app (chat.br-ln.com).
# Copy to .env before scripts/build-web.sh. Everything third-party is off.
VITE_PLATFORM_NAME="BR⚡LN Community"
VITE_PLATFORM_DESCRIPTION="Members chat of the BR⚡LN Club"
VITE_PLATFORM_URL=https://chat.br-ln.com
VITE_PLATFORM_ABOUT=https://services.br-ln.com
VITE_PLATFORM_TERMS=https://services.br-ln.com/terms_conditions
VITE_PLATFORM_PRIVACY=https://services.br-ln.com/terms_conditions
VITE_PLATFORM_LOGO=static/brln-logo.png
VITE_PLATFORM_RELAYS=wss://relay.br-ln.com

# Os guardioes: relays que guardam a mesma conversa que o do clube, para que ela continue
# existindo se a maquina do clube cair. Ficam fora da linha acima de proposito -- aquela e o
# que o chat desenha na barra lateral, e poe-los la daria tres clubes no lugar de um.
VITE_SPACE_MIRRORS=wss://relay2.br-ln.com,wss://relay3.br-ln.com
# Where a refused newcomer is sent: the page that registers the npub, not the dashboard above it.
# Services sends anyone without a subscription on to log in and subscribe.
VITE_PLATFORM_ACCESS_URL=https://services.br-ln.com/comunidade/acesso
VITE_PLATFORM_LOGEE=
VITE_PLATFORM_ACCENT="#ffcc48"
VITE_THEME="brln"
VITE_ALLOW_LOCAL_KEYS=false
VITE_DEFAULT_PUBKEYS=
# Images live on the club's own relay: only members upload, 10 MB per file, and the
# club can delete. A public server would put members' images on someone else's disk.
VITE_DEFAULT_BLOSSOM_SERVERS=https://relay.br-ln.com/
VITE_DEFAULT_SPACES=
VITE_POMADE_SIGNERS=
VITE_PUSH_SERVER=
VITE_PUSH_BRIDGE=
VITE_DUFFLEPUD_URL=
# The link cards come from the club's own server (brln-link-preview), not Coracle's: no third
# party learns which links members open. The address is absolute because the same build runs
# inside each node's LightningOS app, which asks the club's server too.
VITE_LINK_PREVIEW_URL=https://chat.br-ln.com/preview
VITE_PLAUSIBLE_URL=
VITE_PLAUSIBLE_DOMAIN=
VITE_BLOCKED_RELAYS=
VITE_INDEXER_RELAYS=wss://relay.br-ln.com
# Only the profile of whoever is signing in is looked up here, and only when the
# club's space has none for them. No other member's npub is ever asked about.
VITE_PROFILE_IMPORT_RELAYS=wss://purplepag.es,wss://relay.damus.io,wss://nos.lol
VITE_DEFAULT_RELAYS=wss://relay.br-ln.com
VITE_DEFAULT_SEARCH_RELAYS=
# A caixa de correio nomeia os tres relays do clube, e nao so o principal. Ela e o endereco
# por onde as diretas chegam: quem escreve le a caixa DO DESTINATARIO e publica onde ela
# mandar. Com um relay so, uma queda do principal derruba as diretas nos dois sentidos --
# mesmo com os guardioes guardando tudo, do lado de fora, sem ninguem bater na porta.
VITE_DEFAULT_MESSAGING_RELAYS=wss://relay.br-ln.com,wss://relay2.br-ln.com,wss://relay3.br-ln.com
VITE_SIGNER_RELAYS=wss://signer.br-ln.com
VITE_SIGNER_APP_URL=/signer/
VITE_SIGNER_APP_LABEL=Open the BR⚡LN Signer
VITE_THUMBNAIL_URL=
VITE_GLITCHTIP_API_KEY=
GLITCHTIP_AUTH_TOKEN=
VITE_HOSTING_BACKEND_URL=
VITE_HOSTING_RELAY_DOMAIN=
